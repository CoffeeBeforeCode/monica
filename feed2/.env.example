# Feed 2 Environment Variables
#
# Copy this file to .env and fill in your values for local testing
#   cp .env.example .env
#
# In Azure, set these via Azure Portal Configuration or az CLI
# Do NOT commit .env to GitHub (it contains secrets)

# ========== REQUIRED ==========

# Microsoft Teams incoming webhook URL
# Create this in Teams: Channel → Connectors → Incoming Webhook
# URL format: https://outlook.webhook.office.com/webhookb2/...
TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/webhookb2/XXXX

# ========== OPTIONAL (OneDrive/Microsoft Graph) ==========

# Only needed if using OneDrive for persistent state storage
# Leave empty to use local file storage (development only, not persistent)

# Azure Tenant ID
# Find in Azure Portal → Azure AD → Properties
AZURE_TENANT_ID=

# Azure Client ID
# Create in Azure Portal → Azure AD → App Registrations → New Registration
AZURE_CLIENT_ID=

# Azure Client Secret
# Create in App Registration → Certificates & secrets → New client secret
AZURE_CLIENT_SECRET=

# ========== OPTIONAL (Logging) ==========

# Python logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ========== OPTIONAL (Development) ==========

# Set to "local" to use LocalStateManager (not persistent)
# Set to "onedrive" to use OneDriveClient (persistent)
STATE_BACKEND=local

# Dry-run mode (don't actually POST to Teams)
DRY_RUN=false
